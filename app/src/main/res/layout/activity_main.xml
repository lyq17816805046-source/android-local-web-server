<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="本地网页托管"
            app:titleTextColor="@android:color/white"
             />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 服务器状态卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- 状态行 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/statusDot"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/dot_off"
                            android:contentDescription="服务状态" />

                        <TextView
                            android:id="@+id/status"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="服务已停止"
                            android:textSize="16sp"
                            android:textColor="#666666"
                            android:layout_marginStart="10dp" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchServer"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp" />

                    </LinearLayout>

                    <!-- 地址 -->
                    <TextView
                        android:id="@+id/address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="http://—:8080"
                        android:textSize="14sp"
                        android:textColor="#1565C0"
                        android:fontFamily="monospace"
                        android:textIsSelectable="true"
                        android:padding="12dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_address"
                        android:gravity="center" />

                    <!-- 端口输入 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_input"
                        android:paddingHorizontal="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="端口"
                            android:textSize="14sp"
                            android:textColor="#555555" />

                        <EditText
                            android:id="@+id/port"
                            android:layout_width="80dp"
                            android:layout_height="40dp"
                            android:inputType="number"
                            android:text="8080"
                            android:textSize="14sp"
                            android:textColor="#1A1C1E"
                            android:background="@null"
                            android:gravity="center"
                            android:layout_marginStart="8dp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <!-- 站点切换按钮 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSites"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="切换站点"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 公网隧道卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="公网访问（免费隧道）"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#1A1C1E" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchTunnel"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tunnelStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="关闭。开启后可通过外网访问你的站点"
                        android:textSize="13sp"
                        android:textColor="#888888"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tunnelUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="14sp"
                        android:textColor="#1565C0"
                        android:fontFamily="monospace"
                        android:textIsSelectable="true"
                        android:padding="10dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_address"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 文件管理卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="文件管理"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#1A1C1E" />

                        <TextView
                            android:id="@+id/currentSite"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="站点: default"
                            android:textSize="12sp"
                            android:textColor="#888888" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUpload"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="导入文件"
                            app:icon="@drawable/ic_upload"
                            app:iconGravity="textStart"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnImportFolder"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="导入文件夹"
                            app:icon="@drawable/ic_folder"
                            app:iconGravity="textStart"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnImportZip"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="导入ZIP"
                            app:icon="@drawable/ic_zip"
                            app:iconGravity="textStart"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnNewSite"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="新建站点"
                            app:icon="@drawable/ic_add"
                            app:iconGravity="textStart"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <!-- 文件列表 -->
                    <TextView
                        android:id="@+id/fileListTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="当前站点文件:"
                        android:textSize="13sp"
                        android:textColor="#888888"
                        android:layout_marginTop="12dp" />

                    <LinearLayout
                        android:id="@+id/fileList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 日志卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="访问日志"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#1A1C1E" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClearLog"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:minWidth="0dp"
                            android:text="清空"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="250dp"
                        android:layout_marginTop="8dp"
                        android:background="#F7F8FA"
                        android:padding="4dp">

                        <TextView
                            android:id="@+id/log"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="10dp"
                            android:textSize="12sp"
                            android:textColor="#444444"
                            android:fontFamily="monospace"
                            android:textIsSelectable="true"
                            android:text="等待启动..." />

                    </ScrollView>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>