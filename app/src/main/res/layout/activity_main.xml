<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="本地网页托管"
            app:menu="@menu/toolbar_menu" />

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- 页面容器 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- ============ 第1页：服务控制 ============ -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/pageHome"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- 服务器状态卡片 -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/stroke"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:id="@+id/statusDot"
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:src="@drawable/dot_off"
                                    android:contentDescription="服务状态" />

                                <TextView
                                    android:id="@+id/status"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="服务已停止"
                                    android:textSize="16sp"
                                    android:textColor="@color/text_secondary"
                                    android:layout_marginStart="10dp" />

                                <com.google.android.material.switchmaterial.SwitchMaterial
                                    android:id="@+id/switchServer"
                                    android:layout_width="wrap_content"
                                    android:layout_height="48dp" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/address"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="http://—:8080"
                                android:textSize="14sp"
                                android:textColor="@color/accent"
                                android:fontFamily="monospace"
                                android:textIsSelectable="true"
                                android:padding="12dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_address"
                                android:gravity="center" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/bg_input"
                                android:paddingHorizontal="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="端口"
                                    android:textSize="14sp"
                                    android:textColor="@color/text_secondary" />

                                <EditText
                                    android:id="@+id/port"
                                    android:layout_width="80dp"
                                    android:layout_height="40dp"
                                    android:inputType="number"
                                    android:text="8080"
                                    android:textSize="14sp"
                                    android:textColor="@color/text_primary"
                                    android:background="@null"
                                    android:gravity="center"
                                    android:layout_marginStart="8dp" />

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    android:layout_weight="1" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnSites"
                                    style="@style/Widget.Material3.Button.TextButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="40dp"
                                    android:text="切换站点"
                                    android:textSize="13sp" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/statsView"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="今日访问 0 · 累计访问 0"
                                android:textSize="13sp"
                                android:textColor="@color/text_dim"
                                android:layout_marginTop="12dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="8dp">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnQRCode"
                                    style="@style/Widget.Material3.Button.TonalButton"
                                    android:layout_width="0dp"
                                    android:layout_height="44dp"
                                    android:layout_weight="1"
                                    android:text="二维码"
                                    android:textSize="12sp"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:paddingHorizontal="2dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnCopyAddr"
                                    style="@style/Widget.Material3.Button.TonalButton"
                                    android:layout_width="0dp"
                                    android:layout_height="44dp"
                                    android:layout_weight="1"
                                    android:layout_marginStart="6dp"
                                    android:text="复制地址"
                                    android:textSize="12sp"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:paddingHorizontal="2dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnSetPassword"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="44dp"
                                    android:layout_weight="1"
                                    android:layout_marginStart="6dp"
                                    android:text="访问密码"
                                    android:textSize="12sp"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:paddingHorizontal="2dp" />

                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- 公网隧道卡片 -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/stroke">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="公网访问（免费隧道）"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary" />

                                <com.google.android.material.switchmaterial.SwitchMaterial
                                    android:id="@+id/switchTunnel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="48dp" />

                            </LinearLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="隧道方式"
                                android:textSize="13sp"
                                android:textColor="@color/text_dim"
                                android:layout_marginTop="8dp" />

                            <LinearLayout
                                android:id="@+id/providerGroup"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="6dp">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnProvider1"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="44dp"
                                    android:layout_weight="1"
                                    android:text="localhost.run"
                                    android:textSize="12sp"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:paddingHorizontal="4dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnProvider2"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="44dp"
                                    android:layout_weight="1"
                                    android:layout_marginStart="8dp"
                                    android:text="自定义服务器"
                                    android:textSize="12sp"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:paddingHorizontal="4dp" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/tunnelStatus"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="关闭。开启后可通过外网访问你的站点"
                                android:textSize="13sp"
                                android:textColor="@color/text_dim"
                                android:layout_marginTop="8dp" />

                            <TextView
                                android:id="@+id/tunnelUrl"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="14sp"
                                android:textColor="@color/accent"
                                android:fontFamily="monospace"
                                android:textIsSelectable="true"
                                android:padding="10dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_address"
                                android:visibility="gone" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnTestConnection"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:layout_marginTop="8dp"
                                android:text="测试连接"
                                android:textSize="13sp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

            <!-- ============ 第2页：文件管理 ============ -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/pageFiles"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/stroke">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="文件管理"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary" />

                                <TextView
                                    android:id="@+id/currentSite"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="站点: default"
                                    android:textSize="12sp"
                                    android:textColor="@color/text_dim" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="12dp">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnUpload"
                                    style="@style/Widget.Material3.Button.TonalButton"
                                    android:layout_width="0dp"
                                    android:layout_height="48dp"
                                    android:layout_weight="1"
                                    android:text="导入文件"
                                    app:icon="@drawable/ic_upload"
                                    app:iconGravity="textStart"
                                    android:textSize="13sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnImportFolder"
                                    style="@style/Widget.Material3.Button.TonalButton"
                                    android:layout_width="0dp"
                                    android:layout_height="48dp"
                                    android:layout_weight="1"
                                    android:layout_marginStart="8dp"
                                    android:text="导入文件夹"
                                    app:icon="@drawable/ic_folder"
                                    app:iconGravity="textStart"
                                    android:textSize="13sp" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="8dp">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnImportZip"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="48dp"
                                    android:layout_weight="1"
                                    android:text="导入ZIP"
                                    app:icon="@drawable/ic_zip"
                                    app:iconGravity="textStart"
                                    android:textSize="13sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnNewSite"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="48dp"
                                    android:layout_weight="1"
                                    android:layout_marginStart="8dp"
                                    android:text="新建站点"
                                    app:icon="@drawable/ic_add"
                                    app:iconGravity="textStart"
                                    android:textSize="13sp" />

                            </LinearLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="当前站点文件:"
                                android:textSize="13sp"
                                android:textColor="@color/text_dim"
                                android:layout_marginTop="12dp" />

                            <LinearLayout
                                android:id="@+id/fileList"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

            <!-- ============ 第3页：控制台 ============ -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/pageConsole"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/stroke">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="访问日志"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_primary" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnClearLog"
                                    style="@style/Widget.Material3.Button.TextButton"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:insetLeft="0dp"
                                    android:insetRight="0dp"
                                    android:minWidth="0dp"
                                    android:text="清空"
                                    android:textSize="12sp" />

                            </LinearLayout>

                            <ScrollView
                                android:id="@+id/logScrollView"
                                android:layout_width="match_parent"
                                android:layout_height="320dp"
                                android:layout_marginTop="8dp"
                                android:background="@color/bg_log"
                                android:padding="4dp">

                                <TextView
                                    android:id="@+id/log"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:padding="10dp"
                                    android:textSize="12sp"
                                    android:textColor="@color/log_text"
                                    android:fontFamily="monospace"
                                    android:textIsSelectable="true"
                                    android:text="等待启动..." />

                            </ScrollView>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </FrameLayout>

        <!-- 底部玻璃导航栏 -->
        <LinearLayout
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_bottom_bar"
            android:elevation="8dp">

            <LinearLayout
                android:id="@+id/tabHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/tabHomeIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_nav_home"
                    android:contentDescription="服务" />

                <TextView
                    android:id="@+id/tabHomeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="服务"
                    android:textSize="11sp"
                    android:textColor="@color/text_dim"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabFiles"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/tabFilesIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_nav_files"
                    android:contentDescription="文件" />

                <TextView
                    android:id="@+id/tabFilesText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="文件"
                    android:textSize="11sp"
                    android:textColor="@color/text_dim"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabConsole"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/tabConsoleIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_nav_console"
                    android:contentDescription="控制台" />

                <TextView
                    android:id="@+id/tabConsoleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="控制台"
                    android:textSize="11sp"
                    android:textColor="@color/text_dim"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>